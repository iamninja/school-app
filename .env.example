# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api

# Public keys (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Service role key (KEEP SECRET - never expose to browser)
# Used for server-side operations that bypass Row Level Security
# Required for student email verification during signup
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry error tracking
# DSN is public (safe to expose to browser) - get it from your Sentry
# project settings after creating a Next.js project at sentry.io.
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# SENTRY_AUTH_TOKEN (a real secret), SENTRY_ORG, and SENTRY_PROJECT are
# only needed for source-map upload during production builds - set them
# directly in Vercel's project env vars, never in this file or .env.local.

# Encryption key for integration credentials stored in
# private.integration_credentials (AES-256-GCM). Generate ONCE with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of Postgres deliberately - it living in a different trust
# domain than the ciphertext is the entire point. Never a real value here.
# Losing or rotating it makes every stored credential undecryptable, so
# they'd need re-entering through the Business settings UI.
BUSINESS_SECRETS_KEY=your-32-byte-base64-key

# Anthropic API key, used to AI-grade short-answer quiz responses
# (lib/ai-grading.ts) on submission. Get one from https://console.anthropic.com.
# When unset, AI grading is silently skipped and short answers fall back to
# the existing manual-grading queue - not a hard requirement to run the app.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Shared secret for Vercel Cron (vercel.json -> /api/cron/monthly-charges).
# Vercel injects this as `Authorization: Bearer $CRON_SECRET` on scheduled
# invocations. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Set it in Vercel project env vars. If unset, the route fails closed (500)
# rather than treating "no secret configured" as "no auth required".
CRON_SECRET=your-random-secret
