# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api

# Public keys (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Service role key (KEEP SECRET - never expose to browser)
# Used for server-side operations that bypass Row Level Security
# Required for student email verification during signup
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
